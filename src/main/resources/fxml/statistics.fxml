<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitapp.controller.StatisticsController">

    <!-- gleicher Hintergrund wie der Step Counter -->
    <ImageView fitWidth="900"
               fitHeight="620"
               preserveRatio="false"
               opacity="0.9">
        <image>
            <Image url="@/images/stepcounter-image.png" />
        </image>
    </ImageView>

    <!-- weisse Karte mit Diagramm -->
    <VBox spacing="10"
          alignment="TOP_CENTER"
          maxWidth="780"
          maxHeight="560"
          style="-fx-background-color: rgba(255,255,255,0.9);
                 -fx-background-radius: 12;
                 -fx-padding: 18;">

        <Label text="StepCounter Statistik"
               style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <!-- angemeldeter Benutzer -->
        <Label fx:id="userNameLabel" style="-fx-font-weight: bold;" />

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Monat" />
            <ComboBox fx:id="monatBox" onAction="#handleMonatWechsel" />
        </HBox>

        <!-- Balkendiagramm: pro Tag des Monats die erreichten Schritte -->
        <BarChart fx:id="chart" legendVisible="false" VBox.vgrow="ALWAYS">
            <xAxis>
                <CategoryAxis fx:id="xAxis" label="Tag im Monat" />
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="yAxis" label="Erreichte Schritte" />
            </yAxis>
        </BarChart>

        <Button text="Zurueck zum Menue"
                maxWidth="Infinity"
                onAction="#handleBackToMenu" />
    </VBox>

</StackPane>
